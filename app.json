{
  "expo": {
    "name": "Nesora",
    "slug": "nesora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nesora",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F0ED"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nesora.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Nesora uses your camera for video calls",
        "NSMicrophoneUsageDescription": "Nesora uses your microphone for voice and video calls",
        "NSUserNotificationsUsageDescription": "Nesora sends notifications for messages and calls"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2F0ED"
      },
      "package": "com.nesora.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Nesora to access your microphone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1fe332b9-dc07-4e06-9786-b9c1aca3af12"
      }
    },
    "owner": "obidexterken"
  }
}
